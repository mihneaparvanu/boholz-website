---
import Layout from "@/layouts/Layout.astro";
import { getModelBySlug } from "@/db/loaders";
import { toMetaDescription } from "@/lib/format";
import { ROUTES } from "@/features/navigation/routes";
import JsonLd from "@/features/seo/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "@/features/seo/structured-data";

import HousePageNav from "@/features/house-page/components/HousePageNav.vue";
import HeroGallery from "@/features/house-page/components/HeroGallery.vue";
import SideCard from "@/features/house-page/components/SideCard.vue";
import FloorPlanTabs from "@/features/house-page/components/FloorPlanTabs.vue";
import DetailsGrid from "@/features/house-page/components/DetailsGrid.vue";
import CTASection from "@/ui/sections/CTASection.astro";
import Button from "@/ui/primitives/Button.vue";

const { slug } = Astro.params;
const model = await getModelBySlug(slug!);
if (!model) return Astro.redirect("/hauser");

// Must match the section ids rendered below — HousePageNav scroll-spies on
// these, and an id that doesn't exist silently breaks the rail.
const sections = [
  { id: "hausansichten", label: "Hausansichten" },
  { id: "beschreibung", label: "Beschreibung" },
  { id: "daten", label: "Daten" },
  { id: "grundrisse", label: "Grundrisse" },
  { id: "kontakt", label: "Kontakt" },
];

// Use the model's own description; if it's empty, show nothing rather than
// a generic placeholder shared across every house page.
const description = model.description?.trim() || null;
// First-sentence summary for the narrow SideCard.
const lede = description ? (description.match(/^[^.!?]+[.!?]/)?.[0] ?? description) : null;
const hasCategoryDescription = Boolean(model.category?.description);

// Client copy (2026-05): a single advisory paragraph instead of a bulleted
// hard-coded spec list — the actual Leistungsumfang is determined per
// project together with the Fachberater.
const leistungenCopy =
  "Je nach Ihren individuellen Bedürfnissen können wir verschiedene Gewerke und Leistungsumfänge anbieten. Gerne berät Sie unser Fachberater hierzu ausführlich und erstellt gemeinsam mit Ihnen ein passendes Konzept.";

/* Loaders already resolve media.path through getMediaURL(), so these are
   absolute — which both og:image and schema.org require. */
const galleryImages = model.media
  .map((m) => m.media?.path)
  .filter((p): p is string => Boolean(p));
const heroImage =
  model.media.find((m) => m.isHero)?.media?.path ?? galleryImages[0];

/* Supplies the hierarchy the flat /haus/<slug> URL doesn't imply, and
   renders as the path line above the search result. */
const breadcrumb = breadcrumbSchema([
  { name: "Startseite", path: ROUTES.home },
  { name: "Häuser", path: ROUTES.houses },
  { name: model.title, path: ROUTES.house(model.slug) },
]);
---

<Layout
  title={`${model.title} – BoHolz Haus`}
  description={toMetaDescription(model.description)}
  ogImage={heroImage}
>
  <JsonLd data={productSchema(model, galleryImages)} />
  <JsonLd data={breadcrumb} />
  <HousePageNav client:load sections={sections} />

  <section id="hausansichten" class="hero-zone">
    <div class="hero-grid">
      <HeroGallery client:load model={model} />
      <SideCard client:load model={model} lede={lede} />
    </div>
  </section>

  {/* Everything below the gallery is flat — no accordions. Someone on a model
      page is comparing houses, and the figures they compare on (Fläche,
      Etagen, Wohnfläche, Einliegerwohnung) should not cost a click, or sit
      only in the desktop SideCard where mobile never sees them in context. */}

  {(description || hasCategoryDescription) && (
    <section id="beschreibung" class="info">
      <h2 class="section-title">Beschreibung</h2>
      {description && <p class="prose">{description}</p>}
      {hasCategoryDescription && (
        <p class="prose" set:html={model.category?.description} />
      )}
    </section>
  )}

  <section id="daten" class="info">
    <h2 class="section-title">Daten & Ausstattung</h2>
    <DetailsGrid model={model} />
  </section>

  <section id="grundrisse" class="floors">
    <h2 class="section-title">Grundrisse</h2>
    {model.floors.length > 0 ? (
      <FloorPlanTabs client:visible floors={model.floors} />
    ) : (
      <p class="empty">Grundrisse folgen in Kürze.</p>
    )}
  </section>

  {/* Scope note — reads as the last word before the ask, not as a spec. */}
  <section class="info">
    <h2 class="section-title">Leistungsumfang</h2>
    <p class="prose">{leistungenCopy}</p>
  </section>

  <section id="kontakt">
    <CTASection
      heading="Interesse an"
      highlight="diesem Haus?"
      lede="Vereinbaren Sie ein Beratungsgespräch oder lassen Sie sich die Imagebroschüre kostenlos zusenden."
    >
      <Fragment slot="actions">
        <Button variant="primary" size="lg" href="/kontakt">
          Beratungstermin
        </Button>
        <Button variant="tertiary" size="lg" href="/katalog">
          Imagebroschüre anfordern
        </Button>
      </Fragment>
    </CTASection>
  </section>
</Layout>

<style>
  .hero-zone {
    padding-block-start: var(--spacing-4);
    padding-block-end: var(--spacing-5);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-4);
    align-items: start;
  }

  @media (--from-desktop) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 360px;
    }

    .hero-grid > astro-island:last-child {
      position: sticky;
      top: calc(var(--navbar-height) + var(--spacing-5));
    }
  }


  .info,
  .floors {
    padding-block: var(--spacing-5);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .section-title {
    margin: 0 0 var(--spacing-3);
    font-size: var(--fs-h4);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--ls-heading);
  }

  .prose {
    margin: 0 0 var(--spacing-2);
    color: var(--clr-content-secondary);
    line-height: var(--lh-body);
    /* Preserve `\n` paragraph breaks + bullet rows authored in the DB
       description column without forcing markdown parsing on the server. */
    white-space: pre-line;
  }

  .prose:last-child {
    margin-bottom: 0;
  }

  .empty {
    margin: 0;
    color: var(--clr-content-tertiary);
  }

  /* Mobile gets bottom padding so the floating nav never overlaps content. */
  @media (--below-desktop) {
    :global(main.wrapper) {
      padding-block-end: var(--spacing-6);
    }
  }
</style>
