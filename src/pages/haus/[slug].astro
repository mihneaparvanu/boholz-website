---
import Layout from "@/layouts/Layout.astro";
import { houseModels } from "@/domain/house-models/houseModels";
import { categoryOf } from "@/domain/categories/categories.lookup";
import { getMediaURL } from "@/lib/media";
import { toMetaDescription } from "@/lib/format";
import { ROUTES } from "@/features/navigation/routes";
import JsonLd from "@/features/seo/JsonLd.astro";
import { productSchema, breadcrumbSchema } from "@/features/seo/structured-data";

import HousePageNav from "@/features/house-page/components/HousePageNav.vue";
import HeroGallery from "@/features/house-page/components/HeroGallery.vue";
import SideCard from "@/features/house-page/components/SideCard.vue";
import FloorPlanTabs from "@/features/house-page/components/FloorPlanTabs.vue";
import DetailsGrid from "@/features/house-page/components/DetailsGrid.vue";
import CTASection from "@/ui/sections/CTASection.astro";
import Button from "@/ui/primitives/Button.vue";
import IconList from "@/ui/primitives/IconList.vue";
import FeatureCardPair from "@/features/advantage/FeatureCardPair.vue";
import WallAssembly from "@/features/advantage/WallAssembly.astro";
import SpecGroups from "@/features/advantage/SpecGroups.astro";

import {
  energietechnik,
  hitzeschutzschild,
  holzfaserSommer,
  holzfaserWinter,
  sechzehnGruende,
  wallAssemblies,
  wallAssemblyIntro,
  woodFibreBenefits,
} from "@/features/advantage/advantage.content";
import {
  dachSpecGroups,
  fensterSpecGroups,
  haustechnikSpecGroups,
  wandSpecGroups,
} from "@/features/advantage/baubeschreibung.content";
import type { HouseModel } from "@/domain/house-models/houseModels.types";

export async function getStaticPaths() {
  const houses = houseModels;

  return houses.map((h) => ({
    params: {slug: h.slug},
    props: {model: h}
  }))
};

interface Props {
model: HouseModel;
}

const { model } = Astro.props;

const sections = [
  { id: "hausansichten", label: "Hausansichten" },
  { id: "beschreibung", label: "Beschreibung" },
  { id: "daten", label: "Daten" },
  { id: "grundrisse", label: "Grundrisse" },
  { id: "wandaufbau", label: "Wandaufbau" },
  { id: "daemmung", label: "Dämmung" },
  { id: "fenster", label: "Fenster" },
  { id: "dach", label: "Dach" },
  { id: "haustechnik", label: "Haustechnik" },
  { id: "ausstattung", label: "Ausstattung" },
  { id: "kontakt", label: "Kontakt" },
];


const description = model.description?.trim() || null;
const lede = description ? (description.match(/^[^.!?]+[.!?]/)?.[0] ?? description) : null;
const hasCategoryDescription = Boolean(categoryOf(model)?.description);
const leistungenCopy =
  "Je nach Ihren individuellen Bedürfnissen können wir verschiedene Gewerke und Leistungsumfänge anbieten. Gerne berät Sie unser Fachberater hierzu ausführlich und erstellt gemeinsam mit Ihnen ein passendes Konzept.";
const specSourceNote =
  "Technische Angaben: Auszug aus der Bau- und Leistungsbeschreibung, Stand September 2026.";

// og:image and the Product schema both need absolute URLs, so these resolve
// here rather than going through Image.vue.
const galleryImages = model.media
  .map((m) => getMediaURL(m.path))
  .filter((p): p is string => Boolean(p));
const heroImage =
  (() => {
    const h = model.media.find((m) => m.isHero);
    return h ? getMediaURL(h.path) : galleryImages[0];
  })();

const breadcrumb = breadcrumbSchema([
  { name: "Startseite", path: ROUTES.home },
  { name: "Häuser", path: ROUTES.houses },
  { name: model.title, path: ROUTES.house(model.slug) },
]);
---

<Layout
  title={`${model.title} – BoHolz Haus`}
  description={toMetaDescription(model.description)}
  ogImage={heroImage}
>
  <JsonLd data={productSchema(model, galleryImages)} />
  <JsonLd data={breadcrumb} />
  <HousePageNav client:load sections={sections} />

  <section id="hausansichten" class="hero-zone">
    <div class="hero-grid">
      <HeroGallery client:load model={model} />
      <SideCard client:load model={model} lede={lede} />
    </div>
  </section>

  {/* Everything below the gallery is flat — no accordions. Someone on a model
      page is comparing houses, and the figures they compare on (Fläche,
      Etagen, Wohnfläche, Einliegerwohnung) should not cost a click, or sit
      only in the desktop SideCard where mobile never sees them in context. */}

  {(description || hasCategoryDescription) && (
    <section id="beschreibung" class="info">
      <h2 class="section-title">Beschreibung</h2>
      {description && <p class="prose">{description}</p>}
      {hasCategoryDescription && (
        <p class="prose" set:html={categoryOf(model)?.description} />
      )}
    </section>
  )}

  <section id="daten" class="info">
    <h2 class="section-title">Daten & Ausstattung</h2>
    <DetailsGrid model={model} />
  </section>

  <section id="grundrisse" class="floors">
    <h2 class="section-title">Grundrisse</h2>
    {model.floors.length > 0 ? (
      <FloorPlanTabs client:visible floors={model.floors} />
    ) : (
      <p class="empty">Grundrisse folgen in Kürze.</p>
    )}
  </section>

  {/* ── Bauweise & Ausstattung ──────────────────────────────────────────
      Everything from here to the scope note is shared construction spec:
      the same wall build-up, windows, roof and heating every BoHolz house
      is quoted with. It sits below the per-house figures on purpose — a
      visitor compares Wohnfläche first and reads the specification second —
      and it answers the spec questions the model page used to send people
      to /bauen-mit-boholz for. */}

  <section id="wandaufbau" class="info">
    <h2 class="section-title">Wandaufbau & Fassade</h2>
    <p class="spec-prose">
      {wallAssemblyIntro.body}
      <span class="primary">{wallAssemblyIntro.emphasis}</span>
    </p>
    <WallAssembly assemblies={wallAssemblies} />
    <SpecGroups groups={wandSpecGroups} />
  </section>

  <section id="daemmung" class="info">
    <h2 class="section-title">Dämmung & Raumklima</h2>
    <FeatureCardPair
      client:visible
      left={holzfaserSommer}
      right={holzfaserWinter}
    />
    <div class="followups">
      <article class="follow-card">
        <h3 class="follow-heading">{hitzeschutzschild.heading}</h3>
        <p class="spec-prose">
          {hitzeschutzschild.prose.body}
          <span class="primary">{hitzeschutzschild.prose.emphasis}</span>
        </p>
      </article>
      <article class="follow-card">
        <h3 class="follow-heading">Ihre Vorteile auf einen Blick</h3>
        <IconList
          client:visible
          items={woodFibreBenefits}
          columns={2}
          density="comfortable"
        />
      </article>
    </div>
  </section>

  <section id="fenster" class="info">
    <h2 class="section-title">Fenster & Rollläden</h2>
    <SpecGroups groups={fensterSpecGroups} />
  </section>

  <section id="dach" class="info">
    <h2 class="section-title">Decken & Dach</h2>
    <SpecGroups groups={dachSpecGroups} />
  </section>

  <section id="haustechnik" class="info">
    <h2 class="section-title">Heizung & Lüftung</h2>
    <SpecGroups groups={haustechnikSpecGroups} />
    <IconList
      client:visible
      items={energietechnik}
      columns={1}
      density="comfortable"
    />
  </section>

  <section id="ausstattung" class="info">
    <h2 class="section-title">Serienmäßig enthalten</h2>
    <IconList
      client:visible
      items={sechzehnGruende}
      columns={2}
      collapsible
      moreLabel="Alle 16 Gründe anzeigen"
      lessLabel="Weniger anzeigen"
    />
  </section>

  {/* Scope note — reads as the last word before the ask, not as a spec. */}
  <section class="info">
    <h2 class="section-title">Leistungsumfang</h2>
    <p class="prose">{leistungenCopy}</p>
    <p class="source-note">{specSourceNote}</p>
  </section>

  <section id="kontakt">
    <CTASection
      heading="Interesse an"
      highlight="diesem Haus?"
      lede="Vereinbaren Sie ein Beratungsgespräch oder lassen Sie sich das Infopaket kostenlos zusenden."
    >
      <Fragment slot="actions">
        <Button variant="primary" size="lg" href="/kontakt">
          Beratungstermin
        </Button>
        <Button variant="tertiary" size="lg" href="/katalog">
          Infopaket anfordern
        </Button>
      </Fragment>
    </CTASection>
  </section>
</Layout>

<style>
  .hero-zone {
    padding-block-start: var(--spacing-4);
    padding-block-end: var(--spacing-5);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-4);
    align-items: start;
  }

  @media (--from-desktop) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 360px;
    }

    .hero-grid > astro-island:last-child {
      position: sticky;
      top: calc(var(--navbar-height) + var(--spacing-5));
    }
  }


  .info,
  .floors {
    padding-block: var(--spacing-5);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .section-title {
    margin: 0 0 var(--spacing-3);
    font-size: var(--fs-h4);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--ls-heading);
  }

  .prose {
    margin: 0 0 var(--spacing-2);
    color: var(--clr-content-secondary);
    line-height: var(--lh-body);
    /* Preserve `\n` paragraph breaks + bullet rows authored in the DB
       description column without forcing markdown parsing on the server. */
    white-space: pre-line;
  }

  .prose:last-child {
    margin-bottom: 0;
  }

  .empty {
    margin: 0;
    color: var(--clr-content-tertiary);
  }

  /* Spec copy that comes from a content module rather than the DB — so no
     `white-space: pre-line`, which would turn the template's own line
     breaks into rendered ones. The closing sentence lands in primary, the
     same beat as the advantage sections on /bauen-mit-boholz. */
  .spec-prose {
    margin: 0;
    max-width: 70ch;
    color: var(--clr-content-secondary);
    line-height: var(--lh-body);
  }

  .spec-prose .primary {
    color: var(--clr-content-primary);
    font-weight: var(--font-weight-medium);
  }

  .source-note {
    margin: 0;
    font-size: var(--fs-body-sm);
    color: var(--clr-content-tertiary);
  }

  /* Dämmung follow-ups: the Hitzeschutzschild paragraph and the Vorteile
     list, stacked on mobile and side-by-side from desktop. */
  .followups {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4);
  }

  @media (--from-desktop) {
    .followups {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-5);
    }
  }

  .follow-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .follow-heading {
    margin: 0;
    font-size: var(--fs-h6);
    font-weight: var(--font-weight-medium);
    line-height: var(--lh-heading);
    color: var(--clr-content-primary);
  }

  /* Mobile gets bottom padding so the floating nav never overlaps content. */
  @media (--below-desktop) {
    :global(main.wrapper) {
      padding-block-end: var(--spacing-6);
    }
  }
</style>
