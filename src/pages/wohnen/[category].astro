---
import LandingPage from "@/features/landing/LandingPage.astro";
import {
  landingPages,
  type LandingCategory
} from "@/features/landing/landing.registry";


export function getStaticPaths() {
 return Object.keys(landingPages).map((k) => ({
  params: {category: k},
  props: {category: k}
 }))
};

interface Props {
  category: LandingCategory;
}

const {category } = Astro.props;
---

<LandingPage content={landingPages[category]} />
