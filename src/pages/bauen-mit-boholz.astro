---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/ui/sections/PageHero.astro";
import CTASection from "@/ui/sections/CTASection.astro";
import Block from "@/ui/sections/Block.astro";
import SectionNavigator from "@/features/section-navigator/SectionNavigator.vue";
import IconList from "@/ui/primitives/IconList.vue";
import EditorialCard from "@/ui/primitives/EditorialCard.vue";
import Button from "@/ui/primitives/Button.vue";
import { ArrowRight, BookOpen } from "lucide-vue-next";
import { getMediaURL } from "@/lib/media";
import FeatureCardPair from "@/features/advantage/FeatureCardPair.vue";
import WallAssembly from "@/features/advantage/WallAssembly.astro";
import ZigZag, { type ZigZagBlock } from "@/ui/sections/ZigZag.astro";
import { keitel } from "@/features/faq/keitel";
// Shared with every /haus/<slug> model page — the wall build-ups, the
// Holzfaserdämmung pair, the 16 Gründe and the Energietechnik list now live
// in one module so the two surfaces can never show different figures.
import {
  energietechnik,
  hitzeschutzschild,
  holzfaserSommer,
  holzfaserWinter,
  sechzehnGruende,
  wallAssemblies,
  wallAssemblyBenefits,
  wallAssemblyFollowup,
  wallAssemblyIntro,
  woodFibreBenefits,
} from "@/features/advantage/advantage.content";

// ── Section index — drives the SectionNavigator's overview + sticky rail.
const sections = [
  { id: "tradition", eyebrow: "01", label: "Tradition & Innovation" },
  { id: "beweggruende", eyebrow: "02", label: "Beweggründe" },
  { id: "gruende", eyebrow: "03", label: "16 gute Gründe" },
  { id: "nachhaltigkeit", eyebrow: "04", label: "Werkstoff Holz" },
  { id: "holzfaserdaemmung", eyebrow: "05", label: "Holzfaserdämmung" },
  { id: "wandaufbau", eyebrow: "06", label: "Wandaufbau" },
  { id: "technik", eyebrow: "07", label: "Energietechnik" },
];

// ── R2 image URLs for the advantage subsections.
// PageHero, Section 3 media-hero, and Section 4 hero-image previously all
// resolved to the same forest webp (identical R2 etag) — three identical
// "sun-through-trees" frames on one page. They're now diversified: the page
// keeps the forest at the top, then transitions to craftsmanship and material
// detail as the reader descends.
const sustainabilityHero = getMediaURL(
  "/images/stock/lifestyle/house-planning-office.webp",
);
const sustainabilityWorkshop = getMediaURL(
  "/images/stock/lifestyle/craftsmanship-factory.webp",
);
const woodFibreHero = getMediaURL("/images/photography/forest-sunlight.webp");
const phonestripFlyerCover = getMediaURL(
  "/images/pages/bauen-mit-boholz/flyer-phonestrip-cover-2026-09.webp",
);
const phonestripFlyerPDF = getMediaURL(
  "/images/pages/bauen-mit-boholz/flyer-phonestrip-2026-09.pdf",
);
const wallAssemblyHero = getMediaURL(
  "/images/content/advantage/wandaufbau/hero.webp",
);

// ── Zig-zag editorial block — copy lifted from the old boholz-haus.de
// "Bauen mit uns" page per client request. Six alternating image / text
// rows with a "Mehr erfahren" CTA each. Reuses existing R2 imagery for
// thematic fit; client can swap images later.
const zigzagBlocks: ZigZagBlock[] = [
  {
    eyebrow: "Bauen mit dem Werkstoff Holz",
    title: "Der Werkstoff Holz bei BoHolz-Haus",
    body: [
      "Bei BoHolz-Haus bauen wir Ihre individuellen Fertighäuser aus Holz – einem langlebigen Baustoff für Ihr persönliches Zuhause.",
    ],
    closing: "Ein Baustoff. Viele Möglichkeiten. Ihr Zuhause.",
    image: getMediaURL("/images/content/advantage/nachhaltigkeit/hero.webp"),
    imageAlt: "Junger Trieb im Boden — Holzbau bei BoHolz-Haus",
    cta: { href: "#nachhaltigkeit" },
  },
  {
    eyebrow: "Vier Ausbaustufen für jeden Bedarf",
    title: "Ausbaustufen für Ihr BoHolz-Haus",
    body: [
      "Jeder Bauherr ist anders. Eine Familie möchte am liebsten in ein schlüsselfertiges Haus einziehen, andere können und möchten den Innenausbau ganz oder teilweise selbst vornehmen.",
    ],
    closing: "Vom Ausbauhaus bis schlüsselfertig — Sie entscheiden.",
    image: getMediaURL("/images/stock/lifestyle/house-planning-office.webp"),
    imageAlt:
      "Schlüsselübergabe — schlüsselfertiges BoHolz-Haus nach Wunsch",
    cta: { href: "/ihr-neues-zuhause#ausbaustufen" },
  },
  {
    eyebrow: "Von außen gut gedämmt",
    title: "Innovativer Wandaufbau mit hervorragenden Dämmeigenschaften",
    body: [
      "Die Gebäudehülle hat einen entscheidenden Einfluss auf den Energieverbrauch eines Hauses. Eine hochwertige Dämmung reduziert Wärmeverluste, senkt den Heizwärmebedarf und sorgt für dauerhaft niedrigere Energiekosten.",
      "Deshalb setzt BoHolz-Haus konsequent auf Holz als Baustoff. In Kombination mit modernen Wandaufbauten entstehen Energieeffiziente Häuser (KfW-Effizienzhaus 55 oder KfW-Effizienzhaus 40), die Wohnkomfort und Wirtschaftlichkeit miteinander verbinden.",
    ],
    closing: "Diffusionsoffen, leise, dauerhaft.",
    image: getMediaURL("/images/content/advantage/wandaufbau/hero.webp"),
    imageAlt:
      "Holz-Aktiv-Wand Wandaufbau — diffusionsoffener Mehrschichtaufbau für KfW-Effizienzhäuser",
    cta: { href: "#wandaufbau" },
  },
  {
    eyebrow: "Unser oberstes Ziel ist die Zufriedenheit",
    title: "Qualität bei BoHolz-Haus",
    body: [
      "Dicht gefolgt von unserem hohen Qualitätsstandard, den wir Ihnen bieten können.",
      "Unser starker Partner Keitel-Haus greift auf jahrelanges und generationenübergreifendes Wissen rund um den Fertighausbau zurück und gewährleistet handwerkliche Wertarbeit im traditionellen Sinne.",
    ],
    closing: "Wertarbeit, die man fühlt — vom ersten Span bis zur Schlüsselübergabe.",
    image: getMediaURL("/images/stock/lifestyle/craftsmanship-pencil.webp"),
    imageAlt: "Tischler zeichnet präzise auf einem Holzbrett an — handwerkliche Wertarbeit",
    cta: { href: "/uber-uns" },
  },
  {
    title: "Gute Gründe für ein BoHolz Fertighaus",
    body: [],
    bullets: [
      "Individualität als oberstes Maß",
      "Ausbaustufen genau nach Ihren Bedürfnissen",
      "Gut für Ihren Geldbeutel",
      "Zeitersparnis",
      "Ihr Traumhaus made in Germany",
      "Sicherheit für Sie und Ihr Bauprojekt",
      "Unser wichtigstes Ziel: Ihre Zufriedenheit",
    ],
    image: getMediaURL("/images/stock/lifestyle/craftsmanship-factory.webp"),
    imageAlt:
      "Junges Paar entspannt im eigenen BoHolz-Wohnzimmer — gute Gründe für ein BoHolz-Fertighaus",
    cta: { label: "Beratung vereinbaren", href: "/kontakt" },
  },
];

---

<Layout title="Bauen mit BoHolz — BoHolz Haus">
  <!-- 0. Hero ----------------------------------------------------------- -->
  <div class="full-width">
    <PageHero
      eyebrow="Bauen mit BoHolz"
      heading="Mit Vertrauen bauen, mit Qualität"
      highlight="wohnen."
      lede="Handwerkliche Bauqualität. Persönliche Begleitung – vom ersten Entwurf bis zum Einzug."
      image={sustainabilityHero}
      imageAlt="BoHolz Holzbau in der Manufaktur — gelebter Qualitätsanspruch"
      align="center"
    />
  </div>

  <!-- 1. Section overview + sticky rail -------------------------------- -->
  <SectionNavigator client:load pageTitle="Bauen mit BoHolz" sections={sections} stickyOffset={64} />

  <!-- 2. Tradition trifft Innovation ----------------------------------- -->
  <Block
    id="tradition"
    tone="band"
    eyebrow="01 — Tradition & Innovation"
    heading="Generationen-Handwerk, moderne"
    highlight="Fertigung."
    lede="Langjährige Erfahrung, handwerkliche Präzision und moderne Fertigungstechnologien bilden die
Grundlage unserer Häuser. So verbinden wir traditionelle Wertarbeit mit innovativen Bauweisen
– für hochwertige, langlebige Zuhause."
  >
    <div class="steps">
      <EditorialCard
        client:visible
        step={1}
        title="Tradition"
        icon="hammer"
        description={keitel("versprechenTraditionCard")}
      />
      <EditorialCard
        client:visible
        step={2}
        title="Moderne Fertigung"
        icon="wrench"
        description="CNC-gesteuerte Maschinen ermöglichen eine präzise Bearbeitung der Bauteile. Automatisierte Anlagen, klar abgestimmte Produktionsabläufe und die kontinuierliche Weiterentwicklung unserer Fertigungsmethoden bilden die Grundlage unserer Produktion."
      />
      <EditorialCard
        client:visible
        step={3}
        title="Zertifizierungen"
        icon="award"
        description="Mitglied der Qualitätsgemeinschaft Deutscher Fertigbau (QDF) und der Gemeinschaft Deutscher Fertigbau (GDF) — ständige Qualitätssicherung der Materialien, regelmäßige Kontrollen, Eigen- und Fremdüberwachung durch unabhängige Prüfinstitute."
      />
    </div>
  </Block>

  <!-- 2b. Sechs Beweggründe (zig-zag) — copy from the legacy WP "Bauen
       mit uns" page, redesigned with our editorial language. Lives between
       Tradition and "16 gute Gründe" so the page reads:
         01 Tradition → 02 Sechs Beweggründe (zig-zag) → 03 16 gute Gründe →
         04 Nachhaltigkeit → 05 Holzfaserdämmung → 06 Wandaufbau → 07 Technik. -->
  <Block id="beweggruende" eyebrow="02 — Sechs Beweggründe" heading="Was BoHolz-Haus" highlight="für Sie tut." lede="Sechs editoriale Beweggründe — von der Bauweise über Förderung bis zur Qualität, die hinter jedem unserer Häuser steht.">
    <ZigZag blocks={zigzagBlocks} />
  </Block>

  <!-- 3. 16 gute Gründe ------------------------------------------------ -->
  <Block
    id="gruende"
    eyebrow="03 — 16 gute Gründe"
    heading="Was in jedem BoHolz Fertighaus"
    highlight="serienmäßig steckt."
    lede="Vom diffusionsoffenen Wandaufbau bis zur barrierefreien Dusche — sechzehn Details, die wir bereits im Standard liefern."
  >
    <IconList
      client:visible
      items={sechzehnGruende}
      columns={4}
      collapsible
      moreLabel="Alle 16 Gründe anzeigen"
      lessLabel="Weniger anzeigen"
    />
  </Block>

  <!-- 4. Nachhaltigkeit — Hero + Video + Stats -------------------------- -->
  <Block
    id="nachhaltigkeit"
    tone="band"
    eyebrow="04 — Der Werkstoff Holz"
    heading="Bauen mit dem Werkstoff"
    highlight="Holz."
    lede="Bei BoHolz-Haus bauen wir Ihre individuellen Fertighäuser aus Holz — einem langlebigen Baustoff für Ihr persönliches Zuhause."
  >
    <p class="editorial-prose">
      Wir bauen mit Holz — vom Dachstuhl bis zur Holzfaserdämmung. Ein
      Baustoff, der seit Jahrhunderten für langlebige, wohnliche
      Häuser steht.
      <span class="primary">
        Ein Zuhause aus einem Werkstoff, der Generationen überdauert.
      </span>
    </p>

    <figure class="hero-image">
      <img
        src={sustainabilityWorkshop}
        alt="Holzbauweise im BoHolz Werk — von der Materialwahl bis zur Fertigung"
        loading="lazy"
      />
    </figure>
  </Block>

  <!-- 5. Holzfaserdämmung ─ Sommer / Winter ---------------------------- -->
  <Block
    id="holzfaserdaemmung"
    eyebrow="05 — Holzfaserdämmung"
    heading="Wärmeschutz im Winter. Hitzeschutz im Sommer."
    lede="Die diffusionsoffene Außenwand mit Holzfaserdämmung ist auf die Anforderungen unterschiedlicher Jahreszeiten abgestimmt.
Im Winter trägt der Wandaufbau dazu bei, Wärmeverluste zu reduzieren.
Im Sommer unterstützt die Dämmung dabei, den Wärmeeintrag von außen zu begrenzen.
So verbindet die sorgfältig geplante Gebäudehülle Wärmeschutz und Wohnkomfort."
  >
    <figure class="hero-image">
      <img
        src={woodFibreHero}
        alt="Sonnenlicht in einem heimischen Wald — Rohstoff Holz aus regionaler Forstwirtschaft"
        loading="lazy"
      />
    </figure>
    <FeatureCardPair client:visible left={holzfaserSommer} right={holzfaserWinter} />

    <div class="wandaufbau-followups">
      <article class="follow-card">
        <h4 class="follow-heading">{hitzeschutzschild.heading}</h4>
        <p class="editorial-prose">
          {hitzeschutzschild.prose.body}
          <span class="primary">{hitzeschutzschild.prose.emphasis}</span>
        </p>
      </article>

      <article class="follow-card">
        <h4 class="follow-heading">Ihre Vorteile auf einen Blick</h4>
        <IconList client:visible items={woodFibreBenefits} columns={2} density="comfortable" />
      </article>
    </div>

    {/* Holzfaserdämmung-Flyer entfernt (Gesetzesänderung, 2026-09); durch den
        PhoneStrip-Flyer ersetzt (Kundenwunsch). */}
    <aside class="flyer" aria-labelledby="flyer-title">
      <a class="flyer-cover" href={phonestripFlyerPDF} target="_blank" rel="noopener">
        <img
          src={phonestripFlyerCover}
          alt="Vorschau auf den BoHolz-Flyer: Schallschutz mit PhoneStrip"
          loading="lazy"
          width="1702"
          height="2400"
        />
      </a>
      <div class="flyer-body">
        <p class="flyer-eyebrow">Print-Flyer · PDF</p>
        <h3 id="flyer-title" class="flyer-heading">Schallschutz mit PhoneStrip</h3>
        <p class="flyer-lede">
          Die innovativen PhoneStrip-Entkopplungsstreifen reduzieren die
          Schallübertragung zwischen den Geschossen spürbar — alle Details
          kompakt im A4-Format zum Mitnehmen oder Ausdrucken.
        </p>
        <p class="flyer-meta">PDF · A4 · ca. 0,7 MB</p>
        <div class="flyer-actions">
          <Button variant="primary" size="md" href={phonestripFlyerPDF}>
            Flyer herunterladen
          </Button>
        </div>
      </div>
    </aside>

   
  </Block>

  <!-- 6. Wandaufbau ---------------------------------------------------- -->
  <Block
    id="wandaufbau"
    tone="band"
    eyebrow="06 — Wandaufbau"
    heading="Durchdachter Wärmeschutz für jede Jahreszeit"
    lede="Die Gebäudehülle hat wesentlichen Einfluss auf den Wärmeschutz und den Wohnkomfort eines Hauses. Deshalb setzt BoHolz-Haus auf einen durchdachten, diffusionsoffenen Wandaufbau."
  >
    <figure class="hero-image">
      <img
        src={wallAssemblyHero}
        alt="Holz-Aktiv-Wand Wandaufbau — diffusionsoffener Mehrschichtaufbau für KfW-Effizienzhäuser"
        loading="lazy"
      />
    </figure>

    <p class="editorial-prose">
      {wallAssemblyIntro.body}
      <span class="primary">{wallAssemblyIntro.emphasis}</span>
    </p>

    <WallAssembly assemblies={wallAssemblies} />

    <div class="wandaufbau-followups">
      <article class="follow-card">
        <h4 class="follow-heading">{wallAssemblyFollowup.heading}</h4>
        <p class="editorial-prose">
          {wallAssemblyFollowup.prose.body}
          <span class="primary">{wallAssemblyFollowup.prose.emphasis}</span>
        </p>
      </article>

      <article class="follow-card">
        <h4 class="follow-heading">Ihre Vorteile auf einen Blick</h4>
        <IconList client:visible items={wallAssemblyBenefits} columns={2} density="comfortable" />
      </article>
    </div>

  </Block>

  <!-- 7. Haus- & Energietechnik ---------------------------------------- -->
  <Block
    id="technik"
    eyebrow="07 — Energietechnik"
    heading="Wärmepumpen, Photovoltaik und"
    highlight="angenehmes Raumklima."
    lede="Eine sorgfältig geplante Gebäudehülle und die darauf abgestimmte Haustechnik schaffen die Grundlage für modernen Wohnkomfort. Drei Bausteine, die bereits bei der Hausplanung aufeinander abgestimmt werden können."
  >
    <IconList client:visible items={energietechnik} columns={1} density="comfortable" />
  </Block>

  <!-- 8. CTA --------------------------------------------------------- -->
  <div class="full-width">
    <CTASection
      tone="accent"
      heading="Bereit für Ihr"
      highlight="BoHolz-Haus?"
      lede="Vereinbaren Sie eine persönliche Beratung oder bestellen Sie die Imagebroschüre mit allen Modellen und Ausstattungsdetails."
    >
      <Fragment slot="actions">
        <Button client:visible variant="secondary" size="lg" href="/kontakt">
          Beratungstermin vereinbaren
          <ArrowRight slot="trailing" size={16} strokeWidth={2} />
        </Button>
        <Button client:visible variant="ghost" size="lg" href="/katalog">
          <BookOpen slot="leading" size={16} strokeWidth={2} />
          Imagebroschüre anfordern
        </Button>
      </Fragment>
    </CTASection>
  </div>
</Layout>

<style>
  /* Tradition → Modernisierung → Zertifizierungen — three editorial cards. */
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3);
  }

  @media (--from-tablet) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-4);
    }
  }

  /* ── Editorial hero image inside an advantage section. */
  .hero-image {
    margin: 0;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--clr-surface-secondary);
  }

  @media (--from-tablet) {
    .hero-image {
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-lg);
    }
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Nachhaltigkeit hero + video pair. */
  .media-pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-3);
    width: 100%;
  }

  @media (--from-desktop) {
    .media-pair {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-4);
      align-items: start;
    }
  }

  .media-hero {
    margin: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--clr-surface-secondary);
  }

  .media-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Progressive-disclosure: deep wandaufbau spec list. */

  /* ── Flyer download card — lives at the foot of section 04.
        Layout: A4 cover image left, copy + CTA right. Drops to a single
        column under tablet so the cover doesn't squeeze the text. The
        cover is a clickable link to the PDF; the explicit button is the
        primary affordance so screen readers don't only hit the image. ── */
  .flyer {
    display: grid;
    grid-template-columns: minmax(180px, 220px) 1fr;
    gap: var(--spacing-5);
    align-items: start;
    margin-block-start: var(--spacing-5);
    padding: var(--spacing-4);
    border: 1px solid var(--clr-border-secondary);
    border-radius: var(--radius-lg);
    background: var(--clr-surface-primary);
  }

  @media (--below-desktop) {
    .flyer {
      grid-template-columns: 1fr;
      gap: var(--spacing-3);
    }
  }

  .flyer-cover {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-2);
    transition: transform 240ms ease;
  }

  .flyer-cover:hover,
  .flyer-cover:focus-visible {
    transform: translateY(-2px);
  }

  .flyer-cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1743 / 2400;
    object-fit: cover;
  }

  .flyer-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .flyer-eyebrow {
    margin: 0;
    text-transform: uppercase;
    font-size: var(--fs-body-sm);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--clr-content-tertiary);
    font-weight: var(--font-weight-medium);
  }

  .flyer-heading {
    margin: 0;
    font-size: var(--fs-h5);
    font-weight: var(--font-weight-medium);
    line-height: var(--lh-heading);
    color: var(--clr-content-primary);
  }

  .flyer-lede {
    margin: 0;
    color: var(--clr-content-secondary);
    line-height: var(--lh-body);
  }

  .flyer-meta {
    margin: 0;
    font-size: var(--fs-body-sm);
    color: var(--clr-content-tertiary);
  }

  .flyer-actions {
    margin-block-start: var(--spacing-2);
  }

  /* ── Editorial prose: secondary body, primary last-sentence emphasis.
        Per the client brief — adds a final-line highlight to every body
        paragraph so the eye lands on the most important claim. ── */
  .editorial-prose {
    margin: 0;
    color: var(--clr-content-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: 70ch;
  }

  .editorial-prose .primary {
    color: var(--clr-content-primary);
    font-weight: var(--font-weight-medium);
  }

  /* ── Wandaufbau follow-ups: two short cards under the comparison pair.
        "Diffusionsoffen & wohngesund" reads as a value-statement paragraph;
        "Ihre Vorteile" anchors with a 4-bullet IconList. Stacked under
        tablet, side-by-side from desktop. ── */
  .wandaufbau-followups {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-4);
    margin-block-start: var(--spacing-5);
  }

  @media (--from-desktop) {
    .wandaufbau-followups {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-5);
    }
  }

  .follow-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .follow-heading {
    margin: 0;
    font-size: var(--fs-h6);
    font-weight: var(--font-weight-medium);
    line-height: var(--lh-heading);
    color: var(--clr-content-primary);
  }

</style>
