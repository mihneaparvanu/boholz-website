---

<Layout title="Bauen mit BoHolz — BoHolz Haus">
  <!-- 0. Hero ----------------------------------------------------------- -->
  <div class="full-width">
    <PageHero
      eyebrow="Bauen mit BoHolz"
      title="Mit Vertrauen bauen, mit Qualität"
      highlight="wohnen."
      subtitle="Höchste Bauqualität. Persönliche Begleitung – vom ersten Entwurf bis zum Einzug."
      image={nachhaltigkeitHero}
      imageAlt="BoHolz Holzbau in der Manufaktur — gelebter Qualitätsanspruch"
      align="center"
    />
  </div>

  <!-- 1. Section overview + sticky rail -------------------------------- -->
  <SectionNavigator client:load pageTitle="Bauen mit BoHolz" sections={sections} stickyOffset={64} />

  <!-- 2. Tradition trifft Innovation ----------------------------------- -->
  <Block
    id="tradition"
    tone="band"
    eyebrow="01 — Tradition & Innovation"
    heading="Generationen-Handwerk, moderne"
    highlight="Fertigung."
    lede="Langjährige Erfahrung, handwerkliche Präzision und moderne Fertigungstechnologien bilden die
Grundlage unserer Häuser. So verbinden wir traditionelle Wertarbeit mit innovativen Bauweisen
– für hochwertige, langlebige Zuhause."
  >
    <div class="steps">
      <EditorialCard
        client:visible
        step={1}
        title="Tradition"
        icon="hammer"
        description={keitel("versprechenTraditionCard")}
      />
      <EditorialCard
        client:visible
        step={2}
        title="Moderne Fertigung"
        icon="wrench"
        description="CNC-gesteuerte Maschinen ermöglichen eine präzise Bearbeitung der Bauteile. Automatisierte Anlagen, klar abgestimmte Produktionsabläufe und die kontinuierliche Weiterentwicklung unserer Fertigungsmethoden bilden die Grundlage unserer Produktion."
      />
      <EditorialCard
        client:visible
        step={3}
        title="Zertifizierungen"
        icon="award"
        description="Mitglied der Qualitätsgemeinschaft Deutscher Fertigbau (QDF) und der Gemeinschaft Deutscher Fertigbau (GDF) — ständige Qualitätssicherung der Materialien, regelmäßige Kontrollen, Eigen- und Fremdüberwachung durch unabhängige Prüfinstitute."
      />
    </div>
  </Block>

  <!-- 2b. Sechs Beweggründe (zig-zag) — copy from the legacy WP "Bauen
       mit uns" page, redesigned with our editorial language. Lives between
       Tradition and "16 gute Gründe" so the page reads:
         01 Tradition → 02 Sechs Beweggründe (zig-zag) → 03 16 gute Gründe →
         04 Nachhaltigkeit → 05 Holzfaserdämmung → 06 Wandaufbau → 07 Technik. -->
  <Block id="beweggruende" eyebrow="02 — Sechs Beweggründe" heading="Was BoHolz-Haus" highlight="für Sie tut." lede="Sechs editoriale Beweggründe — von der Bauweise über Förderung bis zur Qualität, die hinter jedem unserer Häuser steht.">
    <ZigZag blocks={zigzagBlocks} />
  </Block>

  <!-- 3. 16 gute Gründe ------------------------------------------------ -->
  <Block
    id="gruende"
    eyebrow="03 — 16 gute Gründe"
    heading="Was in jedem BoHolz Fertighaus"
    highlight="serienmäßig steckt."
    lede="Vom diffusionsoffenen Wandaufbau bis zur barrierefreien Dusche — sechzehn Details, die wir bereits im Standard liefern."
  >
    <IconList
      client:visible
      items={sechzehnGruende}
      columns={4}
      collapsible
      moreLabel="Alle 16 Gründe anzeigen"
      lessLabel="Weniger anzeigen"
    />
  </Block>

  <!-- 4. Nachhaltigkeit — Hero + Video + Stats -------------------------- -->
  <Block
    id="nachhaltigkeit"
    tone="band"
    eyebrow="04 — Der Werkstoff Holz"
    heading="Bauen mit dem Werkstoff"
    highlight="Holz."
    lede="Bei BoHolz-Haus bauen wir Ihre individuellen Fertighäuser aus Holz — einem langlebigen, natürlichen Baustoff für Ihr persönliches Zuhause."
  >
    <p class="editorial-prose">
      Wir bauen mit Holz — vom Dachstuhl bis zur Holzfaserdämmung. Ein
      natürlicher Baustoff, der seit Jahrhunderten für langlebige, wohnliche
      Häuser steht.
      <span class="primary">
        Ein Zuhause aus einem Werkstoff, der Generationen überdauert.
      </span>
    </p>

    <figure class="hero-image">
      <img
        src={nachhaltigkeitManufaktur}
        alt="Holzbauweise im BoHolz Werk — von der Materialwahl bis zur Fertigung"
        loading="lazy"
      />
    </figure>
  </Block>

  <!-- 5. Holzfaserdämmung ─ Sommer / Winter ---------------------------- -->
  <Block
    id="holzfaserdaemmung"
    eyebrow="05 — Holzfaserdämmung"
    heading="Wärmeschutz im Winter. Hitzeschutz im Sommer."
    lede="Die diffusionsoffene Außenwand mit Holzfaserdämmung ist auf die Anforderungen unterschiedlicher Jahreszeiten abgestimmt.
Im Winter trägt der Wandaufbau dazu bei, Wärmeverluste zu reduzieren.
Im Sommer unterstützt die Dämmung dabei, den Wärmeeintrag von außen zu begrenzen.
