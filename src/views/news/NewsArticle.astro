---
import { getCollection, render } from "astro:content";

import SiteShell from "@/features/shell/SiteShell.astro";
import Prose from "@/core/design/primitives/Prose.astro";

import Image from "@/core/design/primitives/Image.vue";
import { toMetaDescription, formatNewsDate } from "@/core/format";
import { pagePath } from "@/core/routing";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const news = await getCollection("news");
const post = news.find((n) => n.id === slug);

if (!post) {
  throw new Error(`NewsArticle: no post "${slug}"`);
}

const { title, excerpt, publishedAt, hero } = post.data;
const formattedDate = formatNewsDate(publishedAt);

const { Content } = await render(post);
---

<SiteShell
  title={`${title} – BoHolz Haus`}
  description={toMetaDescription(excerpt)}
>
  <article class="news-detail">
    {
      hero && (
        <div class="hero-image full-width">
          <Image
            path={hero.path}
            alt={hero.alt ?? title}
            width={hero.width}
            height={hero.height}
            loading="eager"
          />
        </div>
      )
    }
    <header class="post-header">
      <a href={pagePath("news")} class="back-link">← Alle News</a>
      {formattedDate && <time class="date">{formattedDate}</time>}
      <h1 class="title">{title}</h1>
      {excerpt && <p class="excerpt">{excerpt}</p>}
    </header>
    <Prose>
      <Content />
    </Prose>
  </article>
</SiteShell>

<style>
  .news-detail {
    grid-column: content;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
    padding-block: var(--spacing-6);
  }

  .hero-image {
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    max-width: 80ch;
    width: 100%;
    margin-inline: auto;
  }

  .back-link {
    font-size: var(--fs-sm);
    color: var(--clr-content-secondary);
    text-decoration: none;

    &:hover {
      color: var(--clr-content-primary);
    }
  }

  .date {
    font-size: var(--fs-sm);
    color: var(--clr-content-tertiary);
  }

  .title {
    font-size: var(--fs-h2);
  }

  .excerpt {
    font-size: var(--fs-body);
    color: var(--clr-content-secondary);
  }
</style>
