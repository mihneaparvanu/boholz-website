---
import ConsentHeader from "./ConsentHeader.astro";
import ConsentButtons from "./ConsentButtons.astro";
import { BANNER_ID } from "./consent";
---

  <dialog id={BANNER_ID} class="popup">
    <ConsentHeader />
    <ConsentButtons />
  </dialog>

<style>
.popup {
  position: fixed;
  inset-inline: var(--spacing-3);
  bottom: var(--spacing-3);
  max-width: 55%;
  margin-inline: auto;
  padding: var(--spacing-3) var(--spacing-4);
  background: var(--clr-surface-primary);
  border: 1px solid var(--clr-border-secondary);
  border-radius: var(--radius-md);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  z-index: 10;

  @media (--below-desktop) {
    max-width: none;
  }
}
</style>

<script>
import { BANNER_ID, applyConsent, CONSENT_PRESETS } from "./consent";
import type { ConsentType } from "./consent.types";

const dialog = document.getElementById(BANNER_ID);
if (dialog instanceof HTMLDialogElement) {
  dialog.addEventListener("command", (e) => {
    if (e.command !== "--choose") return;
    if (!(e.source instanceof HTMLElement)) return;
    const key = e.source.dataset.consent;
    if (!key || !(key in CONSENT_PRESETS)) return;
    applyConsent(key as ConsentType);
    dialog.close();
  })
}
</script>