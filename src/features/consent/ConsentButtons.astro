---
import Button from "@/ui/primitives/Button.vue";
---

  <div class="btns">
    <Button
      size="md"
      variant="primary"
      tone="secondary"
      aria-label="Alle Cookies akzeptieren, einschließlich Statistik und Marketing"
    >
      Alle akzeptieren
    </Button>
    <Button
      size="md"
      variant="primary"
      tone="secondary"
      aria-label="Nur essenzielle und Statistik-Cookies akzeptieren"
    >
      Statistik erlauben
    </Button>
    <Button
      size="md"
      variant="primary"
      tone="secondary"
      aria-label="Nur essenzielle Cookies akzeptieren, Statistik und Marketing ablehnen"
    >
      Nur essenzielle
    </Button>
  </div>


<style>
.btns {
  display: flex;
  gap: var(--spacing-3);
  & > * {
    flex: 1;
    min-width: 0;
  }
  @media (--mobile) {
    flex-direction: column;
  }
}
</style>
