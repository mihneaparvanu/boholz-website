---
import Button from "@/ui/primitives/Button.vue";
import { CONSENT_ORDER, CONSENT_BUTTONS } from "./consent.content";
import { BANNER_ID } from "./consent";
---

  <div class="btns">
    {
      CONSENT_ORDER.map ((key) => {
        const b = CONSENT_BUTTONS[key]
        return (
<Button
command="--choose"
commandfor={BANNER_ID}
data-consent={key}
      size="md"
      variant="primary"
      tone="secondary"
      aria-label={b.ariaLabel}
    >
     {b.title}
    </Button>
      )})
    }
  </div>


<style>
.btns {
  display: flex;
  gap: var(--spacing-3);
  & > * {
    flex: 1;
    min-width: 0;
  }
  @media (--mobile) {
    flex-direction: column;
  }
}
</style>
