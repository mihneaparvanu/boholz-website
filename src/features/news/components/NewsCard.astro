---
import Image from "@/core/design/primitives/Image.vue";
import ImagePlaceholder from "@/core/design/primitives/ImagePlaceholder.vue";

import { formatNewsDate } from "@/core/format";

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"news">;
}

const { entry } = Astro.props;

const { title, excerpt, publishedAt, hero } = entry.data;
---

<a class="news-card" href={entry.id}>
  <div class="image-wrapper">
    {
      hero ? (
        <Image
          path={hero.path}
          alt={hero.alt ?? title}
          width={hero.width}
          height={hero.height}
        />
      ) : (
        <ImagePlaceholder />
      )
    }
  </div>
  <div class="content">
    {publishedAt && <span class="kicker">{formatNewsDate(publishedAt)}</span>}

    <h3 class="title">{title}</h3>
    {excerpt && <p class="excerpt">{excerpt}</p>}
  </div>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    text-decoration: none;
    color: inherit;

    &:hover .image-wrapper img {
      transform: scale(1.03);
    }
  }

  .image-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--clr-surface-secondary);

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .kicker {
    font-size: var(--fs-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--clr-content-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
  }

  .title {
    font-size: var(--fs-h5);
  }

  .excerpt {
    font-size: var(--fs-body);
    color: var(--clr-content-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
