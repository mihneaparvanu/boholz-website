---
/**
 * Landing-page hero — value proposition + the guarantees they offer.
 *
 * Full-bleed house image with a scrim, centred copy, and a row of guarantee
 * "pills" (18 Monate Festpreis, 5 Jahre Gewährleistung …) that surface the
 * warranty/commitment right in the hero. The certification "quality badges"
 * (ProofSection) render directly below this in LandingPage.
 */
import Button from "@/ui/primitives/Button.vue";
import type { TrustBadge } from "@/features/trust/trust-badges.content";
import { getIcon } from "@/lib/icons";
import GermanyFlag from "@/ui/icons/GermanyFlag.vue";

interface Cta {
  label: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  /** Italic-serif accent appended to the heading. */
  highlight?: string;
  lede: string;
  /** Already resolved through getMediaURL() by the caller. */
  image: string;
  imageAlt?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  /** Guarantee/warranty proof points shown as pills. */
  guarantees?: TrustBadge[];
}

const {
  eyebrow,
  heading,
  highlight,
  lede,
  image,
  imageAlt = "",
  primaryCta,
  secondaryCta,
  guarantees = [],
} = Astro.props;
---

<section class="landing-hero full-width">

  <div class="content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}

    <h1>
      {heading}
      {highlight && <span class="highlight"> {highlight}</span>}
    </h1>

    <p class="body">{lede}</p>

    {
      (primaryCta || secondaryCta) && (
        <div class="actions">
          {primaryCta && (
            <Button client:load variant="secondary" size="lg" href={primaryCta.href}>
              {primaryCta.label}
            </Button>
          )}
        </div>
      )
    }

    {
      guarantees.length > 0 && (
        <ul class="guarantees" role="list" aria-label="Unsere Zusagen">
          {guarantees.map((g) => {
            const Icon = g.icon ? getIcon(g.icon) : null;
            return (
              <li>
                {/* `flag` wins over the lucide icon — on "Made in Germany" the
                    flag says it faster than a hammer glyph does. */}
                {g.flag ? (
                  <GermanyFlag />
                ) : (
                  Icon && <Icon size={15} strokeWidth={1.75} aria-hidden="true" />
                )}
                <strong>{g.value}</strong>
                <span>{g.label}</span>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>

  <div class="image-container full-width">
        <img src={image} alt={imageAlt} fetchpriority="high" />
  </div>
</section>

<style>
  .landing-hero {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 0.6fr;
    position: relative;
    isolation: isolate;
    padding-block: var(--spacing-2);
    overflow: hidden;
    color: var(--clr-pure-white);
    --nav-height-multiplier: 1.2;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65%;
    display: block;
  }

  .content {
    background-color: var(--clr-accent-secondary);
    color: var(--clr-pure-white);
    padding-block: var(--spacing-5);
    display: flex;
    padding-inline: var(--spacing-4);
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-3);
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-size: var(--fs-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--clr-surface-primary);
  }

  h1 {
    margin: 0;
    font-weight: var(--font-weight-regular);
    letter-spacing: 0;
    font-size: var(--fs-h2);
    line-height: 1.08;
    text-wrap: balance;
  }
  .highlight {
    font-family: var(--font-secondary);
    font-style: italic;
  }

  .body {
    margin: 0;
    max-width: 46rem;
    font-size: var(--fs-body-lg);
  color: var(--clr-surface-secondary);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-top: var(--spacing-2);
  }

  /* Guarantee pills — the warranty/commitment proof, in the hero. */
  .guarantees {
    list-style: none;
    margin: var(--spacing-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2);
  }
  .guarantees li {
    display: inline-flex;
    /* center, not baseline — an SVG has no baseline to align to, so `baseline`
       drops the icon below the text. */
    align-items: center;
    gap: 0.4ch;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-lg, 999px);
    background: color-mix(in srgb, #fff 16%, transparent);
    border: 1px solid color-mix(in srgb, #fff 28%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: var(--fs-body-sm);
    color: var(--clr-surface-quaternary);
  }
  .guarantees strong {
    font-weight: var(--font-weight-semibold, 600);
  }
  .guarantees span {
    color: var(--clr-surface-quaternary);
  }

  /* Icon sits quieter than the number it precedes. */
  .guarantees svg {
    flex-shrink: 0;
    margin-inline-end: 0.15ch;
    opacity: 0.75;
  }

  /* The flag ships at 40×24 for the homepage stat card — far too big for a
     pill, and it should read at full colour rather than dimmed like a glyph. */
  .guarantees svg.flag {
    height: 0.85em;
    width: auto;
    opacity: 1;
  }

  @media (--from-desktop) {
    .landing-hero {
    grid-template-columns: 1fr 1fr;
    /* Single row + a fixed-ish height so the hero height is CONSISTENT across
       categories and no longer driven by each image's aspect ratio. The image
       cell stretches to this height and object-fit: cover crops it. */
    grid-template-rows: 1fr;
    min-height: clamp(28rem, 40vw, 42rem);
        margin-block-start: calc(-1 * var(--nav-height-multiplier) * var(--navbar-height));
    }

    .content {
          padding-block: calc(1.2 * var(--nav-height-multiplier) * var(--navbar-height)) var(--spacing-5);
      padding-inline-start: max(var(--wrapper-edge), calc(100% - var(--content-max-width)/2));
      align-items: start;
    text-align: left;
    }
  }

</style>
