---
/**
 * Landing-page hero — value proposition + the guarantees they offer.
 *
 * Full-bleed house image with a scrim, centred copy, and a row of guarantee
 * "pills" (18 Monate Festpreis, 5 Jahre Gewährleistung …) that surface the
 * warranty/commitment right in the hero. The certification "quality badges"
 * (ProofSection) render directly below this in LandingPage.
 */
import Button from "@/ui/primitives/Button.vue";
import type { TrustBadge } from "@/features/trust/trust-badges.content";

interface Cta {
  label: string;
  href: string;
}
interface Props {
  eyebrow?: string;
  heading: string;
  /** Italic-serif accent appended to the heading. */
  highlight?: string;
  body: string;
  /** Already resolved through getMediaURL() by the caller. */
  image: string;
  imageAlt?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  /** Guarantee/warranty proof points shown as pills. */
  guarantees?: TrustBadge[];
}

const {
  eyebrow,
  heading,
  highlight,
  body,
  image,
  imageAlt = "",
  primaryCta,
  secondaryCta,
  guarantees = [],
} = Astro.props;
---

<section class="landing-hero full-width">
  <div class="bg">
    <img src={image} alt={imageAlt} fetchpriority="high" />
    <div class="scrim"></div>
  </div>

  <div class="inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}

    <h1>
      {heading}
      {highlight && <span class="highlight"> {highlight}</span>}
    </h1>

    <p class="body">{body}</p>

    {
      (primaryCta || secondaryCta) && (
        <div class="actions">
          {primaryCta && (
            <Button client:load variant="primary" size="lg" href={primaryCta.href}>
              {primaryCta.label}
            </Button>
          )}
          {secondaryCta && (
            <Button client:load variant="secondary" size="lg" href={secondaryCta.href}>
              {secondaryCta.label}
            </Button>
          )}
        </div>
      )
    }

    {
      guarantees.length > 0 && (
        <ul class="guarantees" role="list" aria-label="Unsere Zusagen">
          {guarantees.map((g) => (
            <li>
              <strong>{g.value}</strong>
              <span>{g.label}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .landing-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(30rem, 76vh, 44rem);
    padding-block: var(--spacing-7);
    padding-inline: var(--padding-inline, var(--spacing-4));
    overflow: hidden;
    color: var(--clr-pure-white);
  }

  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Bottom-weighted scrim so copy stays legible over any image. */
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, #000 30%, transparent) 0%,
      color-mix(in srgb, #000 46%, transparent) 55%,
      color-mix(in srgb, #000 62%, transparent) 100%
    );
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-3);
    max-width: 60rem;
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-size: var(--fs-body-sm);
    font-weight: var(--font-weight-medium);
    color: var(--clr-pure-white-soft);
  }

  h1 {
    margin: 0;
    font-weight: var(--font-weight-regular);
    letter-spacing: 0;
    font-size: var(--fs-h1);
    line-height: 1.08;
    text-wrap: balance;
  }
  .highlight {
    font-family: var(--font-secondary);
    font-style: italic;
  }

  .body {
    margin: 0;
    max-width: 46rem;
    font-size: var(--fs-body-lg);
    color: var(--clr-pure-white-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2);
    margin-top: var(--spacing-2);
  }

  /* Guarantee pills — the warranty/commitment proof, in the hero. */
  .guarantees {
    list-style: none;
    margin: var(--spacing-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-2);
  }
  .guarantees li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4ch;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-lg, 999px);
    background: color-mix(in srgb, #fff 16%, transparent);
    border: 1px solid color-mix(in srgb, #fff 28%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: var(--fs-body-sm);
    color: var(--clr-pure-white);
  }
  .guarantees strong {
    font-weight: var(--font-weight-semibold, 600);
  }
  .guarantees span {
    color: var(--clr-pure-white-soft);
  }

  @media (--mobile) {
    h1 {
      font-size: var(--fs-h2);
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }
</style>
