---
/**
 * The landing-page template — one skeleton, many pages.
 *
 * Every `/wohnen/<category>` route renders this component and differs only
 * by the `LandingPageContent` it passes in. Grouped into five conversion
 * beats (see the blueprint block in the markup below):
 *
 *   HERO      hero → certification marks
 *   SHOW      model carousel → category body (two-column prose)
 *   GALLERY   optional, LP-only (renders when `content.gallery` is set)
 *   ASK       single catalog CTA — one button, anchored to #anfordern
 *   BENEFITS  benefits row → audience
 *   FORM      testimonials → FAQ → brochure form (#anfordern)
 *
 * Primary CTAs anchor to #anfordern rather than navigating away — paid
 * traffic should convert here, not elsewhere on the site. Secondary CTAs
 * still offer /kontakt for people who want a conversation instead.
 *
 * The component owns its own data loading (categories + models) so routes
 * stay a single lookup. No copy is hardcoded here: strings come from the
 * page's content module, or from `landing.defaults.ts` for the sections
 * every page shares.
 */
import Layout from "@/layouts/Layout.astro";
import { getMediaURL } from "@/lib/media";

import LandingHero from "./LandingHero.astro";
import Block from "@/ui/sections/Block.astro";
import BenefitsRow from "@/ui/sections/BenefitsRow.astro";
import HouseModelsCarousel from "@/ui/sections/HouseModelsCarousel.vue";
import AudienceBlock from "@/ui/sections/AudienceBlock.astro";
import TwoColumn from "@/ui/sections/TwoColumn.astro";
import TestimonialBand from "@/ui/sections/TestimonialBand.astro";
import CatalogForm from "@/features/contact-forms/CatalogForm.vue";
import CTASection from "@/ui/sections/CTASection.astro";
import FAQAccordion from "@/ui/primitives/FAQAccordion.vue";
import Button from "@/ui/primitives/Button.vue";

import ProofSection from "@/ui/sections/Proof-Section.vue";
import TrustBadges from "@/ui/sections/TrustBadges.vue";

import { getCategories, getModels } from "@/db/loaders";
import { toHouseModelCard } from "@/lib/derive";

import type { LandingPageContent } from "./landing.types";
import { defaultTrustStats } from "./landing.defaults";
import LandingGallery from "./LandingGallery.astro";

interface Props {
  content: LandingPageContent;
}
const { content } = Astro.props;

/* The anatomy of a landing page, in render order. */
const {
  seo,
  hero,
  benefitsIntro,
  benefits,
  houses,
  audience,
  featureBody,
  testimonials,
  faq,
  leadForm,
  midPageCta,
} = content;

/* Parked, not dead: the guarantee/stat row ("18 Monate Festpreis") is being
   folded into the hero redesign rather than standing as its own band, so the
   content hook and component stay wired up and ready. */
const trustStats = content.trustStats ?? defaultTrustStats;
void trustStats;
void TrustBadges;


const categories = await getCategories();
const allModels = await getModels();

const featuredOnly = houses.featuredOnly ?? true;
const filteredModels = allModels
  .filter((m) => (featuredOnly ? m.isFeatured : true))
  .filter((m) =>
    houses.categorySlugs === null
      ? true
      : houses.categorySlugs.includes(m.category?.slug ?? ""),
  )
  .slice(0, houses.maxItems);

const houseCards = filteredModels.map((m) => toHouseModelCard(m));

const heroImage = getMediaURL(hero.imageFallbackPath);
const featureBodyImage = getMediaURL(featureBody.imageFallbackPath);
---

{/* noindex: these pages exist to receive Google Ads traffic. Left indexable
    they compete with /hauser and /haus/<slug> for the same German keywords,
    and organic depth belongs on those pages, which carry no conversion
    mandate. `follow` is deliberate — links out still pass authority. */}
<Layout
  title={seo.title}
  description={seo.description}
  categories={categories}
  noindex
>

  {/* ================================================================
       LANDING-PAGE STRUCTURE — target blueprint (annotate + iterate)
       ----------------------------------------------------------------
       # HERO      value proposition + quality badges + guarantee time
       # FEATURE   Meet <HouseCategory>: body + most common FAQs of this type
       # BENEFITS  the four benefits (+ audience use-cases)
       # GALLERY   LP-only photo gallery  (content.gallery — created per page)
       # FORM      lead magnet: "Download our house catalog for free! Enter your email"
       Existing sections are kept, grouped and reordered under these headings.
     ================================================================ */}

  <!-- ═══════════════════════ HERO · value proposition + quality badges + guarantee ═══════════════════════ -->
  <div class="full-width">
    <LandingHero
      eyebrow={hero.eyebrow}
      heading={hero.heading}
      highlight={hero.highlight}
      lede={hero.lede}
      image={heroImage}
      imageAlt={hero.imageAlt}
      primaryCta={hero.primaryCta}
      secondaryCta={hero.secondaryCta}
      guarantees={trustStats.badges}
    />
  </div>

  <!-- Quality badges (certification marks) -->
  <Block>
    <ProofSection />
  </Block>

    <!-- Meet the category — body -->
  <Block id="nachhaltigkeit">
    <TwoColumn
      eyebrow={featureBody.eyebrow}
      heading={featureBody.heading}
      highlight={featureBody.highlight}
      lede={featureBody.lede}
      image={featureBodyImage}
      imageAlt={featureBody.imageAlt}
      reverse={featureBody.reverse}
    >
      <div class="prose">
        {featureBody.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      {featureBody.cta && (
        <Fragment slot="actions">
          <Button client:load variant="primary" size="md" href={featureBody.cta.href}>
            {featureBody.cta.label}
          </Button>
        </Fragment>
      )}
    </TwoColumn>
  </Block>


  <!-- ═══════════════════════ SHOW · the models of this category ═══════════════════════ -->
  <Block
    id="hausmodelle"
    eyebrow={houses.eyebrow}
    heading={houses.heading}
    highlight={houses.highlight}
    lede={houses.lede}
  >
    {
      houseCards.length > 0 ? (
        <HouseModelsCarousel
          client:visible
          models={houseCards}
          ariaLabel="Hausmodelle dieser Kategorie"
        />
      ) : (
        <p class="empty">
          Aktuell keine Modelle in dieser Kategorie. Bitte sehen Sie sich
          <a href="/hauser"> die vollständige Übersicht </a>
          an.
        </p>
      )
    }
  </Block>

    <!-- ═══════════════════════ GALLERY · LP-only (new) ═══════════════════════ -->

  <!-- Gallery: LP-only. Renders only when the page defines content.gallery.
       (New section — gallery content is created per landing page.) -->
  {content.gallery && (
    <Block
      id="galerie"
      eyebrow={content.gallery.eyebrow}
      heading={content.gallery.heading}
      highlight={content.gallery.highlight}
      lede={content.gallery.lede}
    >
      <LandingGallery images={content.gallery.images} />
    </Block>
  )}
  
  <!-- ═══════════════════════ ASK · single catalog CTA ═══════════════════════ -->
  <!-- One button only: get the catalog. Sits after the gallery so the ask
       lands once the category has actually been shown, and anchors to
       #anfordern rather than sending paid traffic off the page. -->
  <div class="full-width">
    <CTASection
      eyebrow={midPageCta.eyebrow}
      heading={midPageCta.heading}
      highlight={midPageCta.highlight}
      lede={midPageCta.lede}
      tone={midPageCta.tone}
      image={midPageCta.imageFallbackPath ? getMediaURL(midPageCta.imageFallbackPath) : undefined}
      imageAlt={midPageCta.imageAlt ?? ""}
    >
      <Fragment slot="actions">
        <Button client:load variant="primary" size="lg" href={midPageCta.primaryCta.href}>
          {midPageCta.primaryCta.label}
        </Button>
      </Fragment>
    </CTASection>
  </div>

  <!-- ═══════════════════════ BENEFITS ═══════════════════════ -->
  <!-- ── 03 · Benefits row ─────────────────────────────────────── -->
  <Block
    id="vorteile"
    eyebrow={benefitsIntro.eyebrow}
    heading={benefitsIntro.heading}
    highlight={benefitsIntro.highlight}
    lede={benefitsIntro.lede}
  >
    <BenefitsRow items={benefits} />
  </Block>

  <!-- ── 06 · Audience block ───────────────────────────────────── -->
  <Block
    id="zielgruppen"
    eyebrow={audience.eyebrow}
    heading={audience.heading}
    highlight={audience.highlight}
    lede={audience.lede}
  >
    <AudienceBlock items={audience.items} />
    <Fragment slot="actions">
      <Button client:load variant="primary" size="md" href={hero.primaryCta.href}>
        {hero.primaryCta.label}
      </Button>
      <Button client:load variant="ghost" size="md" href={hero.secondaryCta.href}>
        {hero.secondaryCta.label}
      </Button>
    </Fragment>
  </Block>


  <!-- Social proof, placed immediately before the ask -->
  <!-- ── 09 · Testimonials (full-bleed dark band) ───────────────── -->
  <TestimonialBand
    eyebrow={testimonials.eyebrow}
    heading={testimonials.heading}
    highlight={testimonials.highlight}
    lede={testimonials.lede}
    tone={testimonials.tone}
    badges={testimonials.badges}
    testimonials={testimonials.testimonials}
  />




  <!-- Most common FAQs about this type of house -->
  <!-- ── 10 · FAQ ──────────────────────────────────────────────── -->
  <Block
    id="faq"
    eyebrow={faq.eyebrow}
    heading={faq.heading}
    highlight={faq.highlight}
  >
    <div class="faq-wrap">
      <FAQAccordion
        client:visible
        items={faq.items}
        defaultOpen={faq.defaultOpen}
      />
    </div>
  </Block>

  <!-- ═══════════════════════ FORM · lead magnet — free house catalog ═══════════════════════ -->
  <!-- Lead magnet: "Download our house catalog for free."
       The brochure form (name / e-mail / PLZ / Ort) — posts to /api/catalog,
       reveals the PDF on success and fires generate_lead. -->
  <!-- ── 11 · Lead form (full-bleed band) ───────────────────────── -->
  <Block
    id="anfordern"
    tone="band"
    eyebrow={leadForm.eyebrow}
    heading={leadForm.heading}
    highlight={leadForm.highlight}
    lede={leadForm.lede}
  >
    <div class="form-wrap">
      <CatalogForm client:visible />
    </div>
  </Block>

</Layout>

<style>
  /* Empty-state copy when no DB models match the page's category filter. */
  .empty {
    margin: 0;
    padding: var(--spacing-3) 0;
    color: var(--clr-content-tertiary);
    font-size: var(--fs-body);
    text-align: center;
  }

  .empty a {
    color: var(--clr-accent-secondary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--clr-accent-secondary) 40%, transparent);
    text-underline-offset: 2px;
  }

  /* Sustainability paragraphs — vertical stack inside TwoColumn's default
     slot. Width is governed by TwoColumn's content column. */
  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    max-width: 64ch;
  }

  .prose p {
    margin: 0;
    color: var(--clr-content-secondary);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* FAQ accordion — bounded width on wide displays for legibility. */
  .faq-wrap {
    max-width: 56rem;
    width: 100%;
    margin-inline: auto;
  }

  /* Lead-form wrapper — constrain the CatalogForm to a comfortable measure
     inside the centered band. */
  .form-wrap {
    max-width: 36rem;
    width: 100%;
    margin-inline: auto;
    margin-block-start: var(--spacing-4);
  }
</style>
