---
/**
 * Landing-page photo gallery — LP-only section.
 *
 * A responsive image grid. Content comes from the page's optional
 * `content.gallery`; the wrapping heading/eyebrow/lede is provided by the
 * parent `<Block>` in LandingPage.astro, so this component is just the grid.
 */
import { getMediaURL } from "@/lib/media";
import type { LandingGalleryImage } from "./landing.types";

interface Props {
  images: LandingGalleryImage[];
}
const { images } = Astro.props;
---

<ul class="gallery" role="list">
  {
    images.map((img) => (
      <li class="tile">
        <img src={getMediaURL(img.src)} alt={img.alt} loading="lazy" />
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-3);
    grid-template-columns: repeat(2, 1fr);
  }

  @media (--from-tablet) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tile {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    aspect-ratio: 4 / 3;
    background: var(--clr-surface-secondary);
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
