---
import "@/ui/style/reset.css";
import "@/ui/style/design-system.css";
import "@/ui/style/wrapper.css";
import "@/ui/style/ai-badge.css";

import certificationsSprite from "@/features/certifications/certifications.svg?raw";

import Navbar from "@/features/navigation/navbar/Navbar.vue";
import Footer from "@/features/navigation/footer/Footer.astro";
import ConsentBanner from "@/features/consent/ConsentBanner.vue";
import { readConsent, COOKIE_NAME } from "@/features/consent/consent";

import { getCategories, getLocations } from "@/db/loaders";
import { getMediaURL } from "@/lib/media";
import JsonLd from "@/features/seo/JsonLd.astro";
import { organizationSchema } from "@/features/seo/structured-data";
import type { HouseCategory } from "@/db/models";

interface Props {
  title: string;
  /** Meta description. ~150-160 chars; omitted entirely when not supplied,
   *  which is better than an empty tag — Google then writes its own. */
  description?: string;
  categories?: HouseCategory[];
  isHero?: boolean;
  /**
   * Keep the page out of the index. Set on pages that exist to receive paid
   * traffic (the `/wohnen/*` landings) — they'd otherwise compete with
   * `/hauser` and the model pages for the same German keywords.
   */
  noindex?: boolean;
  /**
   * Preview image for shared links (WhatsApp, LinkedIn, Slack…). Must be an
   * absolute URL — `getMediaURL()` returns one. Pages that have a hero
   * should pass it; everything else falls back to the brand image.
   */
  ogImage?: string;
}

const {
  title,
  description,
  categories: categoriesProp,
  isHero = false,
  noindex = false,
  ogImage,
} = Astro.props;

/**
 * Canonical URL — origin from `site` in astro.config.mjs, path from the
 * request with query strings dropped, so `?utm_source=…` and `?gclid=…`
 * (which every ad click carries) don't fragment the page's identity.
 */
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/**
 * Link-preview image. TODO: replace with a purpose-made 1200×630 brand card —
 * this is a real photo, so it crops differently across platforms. Any image
 * beats none: without og:image a shared link renders as a bare URL.
 */
const socialImage =
  ogImage ?? getMediaURL("/images/pages/uber-uns/value-1.webp");

const categories = categoriesProp ?? (await getCategories());
const showhouses = await getLocations({ kind: "showhouse" });

const rawConsent = Astro.cookies.get(COOKIE_NAME)?.value ?? null;
const consent = readConsent(rawConsent);
const showBanner = consent === null;
const loadGTM = consent !== null && (consent.analytics || consent.marketing);
const GTM_ID = import.meta.env.PUBLIC_GTM_ID;
---

<html lang="de" data-hero={isHero ? "true" : "false"}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Link previews. Read by WhatsApp, LinkedIn, Facebook, Slack, iMessage —
        none of which look at <meta name="description">, which is why the same
        sentence is declared twice. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BoHolz Haus" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content="summary_large_image" />

    <JsonLd data={organizationSchema()} />
    {loadGTM && GTM_ID && (
      <>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];window.dataLayer.push({'gtm.start':new Date().getTime(),event:'gtm.js'});`} />
        <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`} />
      </>
    )}
  </head>
  <body>
    <Fragment set:html={certificationsSprite} />
    <Navbar
      client:load
      categories={categories}
      showhouses={showhouses}
    />
    <main class="wrapper">
      <ConsentBanner
        gtmId={GTM_ID}
        initialOpen={showBanner}
        initialConsent={consent}
        client:load
      />
      <slot />
      <Footer />
    </main>
    {/* AI-image notice („KI-generiert", EmpCo/UWG) is now pure CSS — see
        `@/ui/style/ai-badge.css`. No JavaScript. */}
  </body>
</html>
