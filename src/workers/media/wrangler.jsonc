{
    "name": "boholz-media",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",

    "r2_buckets": [
      {
        "binding": "BUCKET",
        "bucket_name": "boholz-media",
        "jurisdiction": "eu"
      }
    ],

    "routes": [
      { "pattern": "boholz-haus.de/m/*", "zone_name":
  "boholz-haus.de" }
    ]
 }