{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // `dev/` is scratch space, not shipped code — see CLAUDE.md. Its sandbox
  // pages still import `@/components/*` and `@/utils/*`, a structure that
  // predates the ui/ + lib/ reorg, so type-checking them produced ~52 errors
  // that buried real ones in src/. They are reference-only (their README says
  // to copy a file into src/pages/ to view it, which would need a port first).
  // `workers/` is a separate deploy unit built by wrangler, not by Astro. It
  // uses the Workers runtime types (caches.default, R2Bucket), which this
  // config's DOM lib does not have — it has its own tsconfig and
  // worker-configuration.d.ts.
  "exclude": ["dist", "workers"],
  "compilerOptions": {
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
